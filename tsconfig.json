{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "rootDir": ".",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,
    "moduleResolution": "node",

    "resolveJsonModule": true,

    "skipLibCheck": true,

    "types": ["node", "jest"]
  },

  "include": [
    "src",
    "test"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}